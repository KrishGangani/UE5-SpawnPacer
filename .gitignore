# P02_SpawnPacer repository: docs + the UE project in SpawnPacer/.
# Generated by Unreal / Visual Studio. Never commit.
SpawnPacer/Binaries/
SpawnPacer/Intermediate/
SpawnPacer/Saved/
SpawnPacer/DerivedDataCache/
SpawnPacer/Build/
SpawnPacer/Plugins/*/Binaries/
SpawnPacer/Plugins/*/Intermediate/
SpawnPacer/.vs/
SpawnPacer/*.sln
SpawnPacer/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# Parked code and doc drafts (never committed; the shared session scratchpad must not hold them).
_wip/
